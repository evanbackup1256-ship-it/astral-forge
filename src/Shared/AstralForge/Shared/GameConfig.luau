local ZONE_FAST_TIER = 3400
local ZONE_TAIL_RATE = 1.000055

local function ln1p(x: number): number
	local p = 1 + x
	if p == 1 then
		return x
	end
	return math.log(p) * x / (p - 1)
end

local function zoneMultiplier(tier: number): number
	local steps = math.max(0, tier)
	local fast = math.min(steps, ZONE_FAST_TIER)
	local tail = steps - fast
	local ln = math.log(12) + fast * math.log(1.22)
	if tail > 0 then
		ln += tail * ln1p(ZONE_TAIL_RATE - 1)
	end
	if ln ~= ln or ln >= math.log(1e308) then
		return 1e300
	end
	local value = math.exp(ln)
	if value ~= value or value >= 1e308 then
		return 1e300
	end
	return value
end

function GameConfig.ResolveZone(id: number)
	local authored = GameConfig.Zones[id]
	if authored then
		return authored
	end
	local index = math.floor(id)
	if index < 1 or index > GameConfig.MaxZone then
		return nil
	end
	local hue = ((index * 47) % 360) / 360
	local color = Color3.fromHSV(hue, 0.55, 0.92)
	local dark = Color3.fromHSV(hue, 0.62, 0.28)
	local authoredCount = 0
	for _ in GameConfig.Zones do
		authoredCount += 1
	end
	local tier = index - authoredCount
	local costExponent = math.log(25_000_000_000) + math.max(0, tier - 1) * math.log(1.85)
	local cost: number | string
	if costExponent < math.log(1e308) then
		cost = 25_000_000_000 * (1.85 ^ math.max(0, tier - 1))
	else
		local log10 = costExponent / math.log(10)
		local exp = math.floor(log10)
		cost = string.format("%.8fe%d", 10 ^ (log10 - exp), exp)
	end
	local cores = math.floor(20 + tier * 3 + tier ^ 1.15)
	local rebirths = math.floor(20 + tier * 2)
	local name = ZONE_NAMES[((index - 1) % #ZONE_NAMES) + 1]
	local flavor = ((index - 1) % #ZONE_TAGLINES) + 1
	return {
		Id = index,
		Name = string.format("%s %d", name, index),
		Tagline = ZONE_TAGLINES[flavor],
		Description = ZONE_DESCRIPTIONS[flavor],
		Lore = ZONE_LORE[flavor],
		Features = ZONE_FEATURES[flavor],
		Layout = ZONE_LAYOUTS[((index - 1) % #ZONE_LAYOUTS) + 1],
		ThemeIndex = ((index - 1) % 5) + 1,
		Cost = cost,
		CoreCost = cores,
		Multiplier = zoneMultiplier(tier),
		RequiredRebirths = rebirths,
		Color = color,
		DarkColor = dark,
	}
end

function GameConfig.ResolveExpedition(id: string)
	for _, expedition in GameConfig.Operations.Expeditions do
		if expedition.Id == id then
			return expedition
		end
	end
	local seed = string.match(id, "^HorizonRun_(%d+)$")
	local index = seed and tonumber(seed)
	if not index or index < 1 or index > GameConfig.MaxGeneratedExpeditions then
		return nil
	end
	local hue = ((index * 29) % 360) / 360
	return {
		Id = id,
		Name = string.format("Horizon Run %d", index),
		Description = "A generated deep-range salvage. Same claim path, no extra instances.",
		Duration = math.clamp(30 + index * 18, 30, 8 * 60 * 60),
		RequiredLevel = math.clamp(1 + math.floor(index / 4), 1, 80),
		Reward = {
			CashMinutes = 8 + index * 3,
			Stardust = 4 + math.floor(index * 0.8),
			Signals = 8 + index,
			CommandXP = 90 + index * 16,
		},
		ArtifactChance = math.clamp(0.8 - index * 0.0015, 0.12, 0.8),
		ArtifactId = GameConfig.Operations.Artifacts[(index - 1) % math.min(12, #GameConfig.Operations.Artifacts) + 1].Id,
		Color = Color3.fromHSV(hue, 0.5, 0.9),
	}
end

