function GameConfig.ResolveZone(id: number)
	local authored = GameConfig.Zones[id]
	if authored then
		return authored
	end
	local index = math.floor(id)
	if index < 1 or index > GameConfig.MaxZone then
		return nil
	end
	local hue = ((index * 47) % 360) / 360
	local color = Color3.fromHSV(hue, 0.55, 0.92)
	local dark = Color3.fromHSV(hue, 0.62, 0.28)
	local authoredCount = 0
	for _ in GameConfig.Zones do
		authoredCount += 1
	end
	local tier = index - authoredCount
	local costExponent = math.log(25_000_000_000) + math.max(0, tier - 1) * math.log(1.85)
	local cost: number | string
	if costExponent < math.log(1e308) then
		cost = 25_000_000_000 * (1.85 ^ math.max(0, tier - 1))
	else
		local log10 = costExponent / math.log(10)
		local exp = math.floor(log10)
		cost = string.format("%.8fe%d", 10 ^ (log10 - exp), exp)
	end
	local cores = math.floor(20 + tier * 3 + tier ^ 1.15)
	local rebirths = math.floor(20 + tier * 2)
	local name = ZONE_NAMES[((index - 1) % #ZONE_NAMES) + 1]
	local flavor = ((index - 1) % #ZONE_TAGLINES) + 1
	return {
		Id = index,
		Name = string.format("%s %d", name, index),
		Tagline = ZONE_TAGLINES[flavor],
		Description = ZONE_DESCRIPTIONS[flavor],
		Lore = ZONE_LORE[flavor],
		Features = ZONE_FEATURES[flavor],
		Layout = ZONE_LAYOUTS[((index - 1) % #ZONE_LAYOUTS) + 1],
		ThemeIndex = ((index - 1) % 5) + 1,
		Cost = cost,
		CoreCost = cores,
		Multiplier = 12 * (1.22 ^ math.max(0, tier)),
		RequiredRebirths = rebirths,
		Color = color,
		DarkColor = dark,
	}
end

function GameConfig.ResolveExpedition(id: string)
	for _, expedition in GameConfig.Operations.Expeditions do
		if expedition.Id == id then
			return expedition
		end
	end
	local seed = string.match(id, "^HorizonRun_(%d+)$")
	local index = seed and tonumber(seed)
	if not index or index < 1 or index > GameConfig.MaxGeneratedExpeditions then
		return nil
	end
	local hue = ((index * 29) % 360) / 360
	return {
		Id = id,
		Name = string.format("Horizon Run %d", index),
		Description = "A generated deep-range salvage. Same claim path, no extra instances.",
		Duration = math.clamp(30 + index * 18, 30, 8 * 60 * 60),
		RequiredLevel = math.clamp(1 + math.floor(index / 4), 1, 80),
		Reward = {
			CashMinutes = 8 + index * 3,
			Stardust = 4 + math.floor(index * 0.8),
			Signals = 8 + index,
			CommandXP = 90 + index * 16,
		},
		ArtifactChance = math.clamp(0.8 - index * 0.0015, 0.12, 0.8),
		Color = Color3.fromHSV(hue, 0.5, 0.9),
	}
end

-- Lazy-load the heavy generated tables so require(GameConfig) returns immediately.
-- The tables are only materialized on first access (iteration, length, or missing key).
local function attachLazyLoader(target, generator)
	local generated = false
	local function ensureGenerated()
		if generated then
			return
		end
		generated = true
		setmetatable(target, nil)
		generator()
	end
	local mt = getmetatable(target)
	if mt == nil then
		mt = {}
		setmetatable(target, mt)
	end
	mt.__index = function(_t, key)
		ensureGenerated()
		return rawget(target, key)
	end
	mt.__len = function(_t)
		ensureGenerated()
		return #target
	end
	mt.__iter = function(_t)
		ensureGenerated()
		return next, target, nil
	end
end

attachLazyLoader(GameConfig.Machines, generateMachines)
attachLazyLoader(GameConfig.Research, generateResearch)
attachLazyLoader(GameConfig.Zones, generateZones)
attachLazyLoader(GameConfig.GridUpgrades, generateGridUpgrades)
attachLazyLoader(GameConfig.Operations.SeasonTiers, generateSeasonTiers)
attachLazyLoader(GameConfig.Anomalies.Milestones, generateMilestones)

-- At build time the heavy generated tables are precomputed into GameConfigGenerated.
-- When that module is present, load it so the game never pays the generation cost at runtime.
local generatedOk, Generated = pcall(function()
	return require(script.Parent:WaitForChild("GameConfigGenerated"))
end)
if generatedOk then
	GameConfig.Machines = Generated.Machines
	GameConfig.Research = Generated.Research
	GameConfig.Zones = Generated.Zones
	GameConfig.GridUpgrades = Generated.GridUpgrades
	GameConfig.Operations.SeasonTiers = Generated.SeasonTiers
	GameConfig.Anomalies.Milestones = Generated.Milestones
end

return GameConfig
