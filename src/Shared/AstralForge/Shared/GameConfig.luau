		local noun = RESEARCH_NOUN[(((index - 1) // #RESEARCH_PREFIX) % #RESEARCH_NOUN) + 1]
		local cycle = (index - 1) // (#RESEARCH_PREFIX * #RESEARCH_NOUN)
		local name = cycle > 0 and string.format("%s %s %d", prefix, noun, cycle + 1) or (prefix .. " " .. noun)
		table.insert(research, {
			Id = "HorizonStudy_" .. tostring(index),
			Name = name,
			Description = "A permanent research bonus. Stays after rebirth.",
			BaseCost = studyBaseCost(index),
			CostScale = 1.85 + (index % 8) * 0.02,
			MaxLevel = ENDLESS_LEVEL_CAP,
			Endless = true,
			RequiredRebirths = math.floor(1 + index * 0.25),
			RequiredZone = math.clamp(2 + math.floor(index / 3), 1, GameConfig.MaxZone),
