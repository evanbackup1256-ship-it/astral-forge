local function generateZones()
	local zones = rawget(GameConfig, "Zones")
	local count = #zones
	local lastAuthoredId = 0
	for index = 1, count do
		local zone = zones[index]
		if type(zone) == "table" and type(zone.Id) == "number" and zone.Id > lastAuthoredId then
			lastAuthoredId = zone.Id
		end
	end
	local startId = lastAuthoredId + 1
	for id = startId, 125 do
		local tier = id - lastAuthoredId
		local prefix = worldPrefixes[(tier - 1) % #worldPrefixes + 1]
		local noun = worldNouns[math.floor((tier - 1) / #worldPrefixes) + 1]
		local paletteIndex = (id * 17) % 360
		local color = Color3.fromHSV(paletteIndex / 360, 0.7, 0.98)
		local darkColor = color:Lerp(Color3.fromRGB(7, 10, 24), 0.78)
		local costExponent = math.min(700, math.log(25_000_000_000) + tier * 0.095)
		count += 1
		zones[count] = {
			Id = id,
			Name = prefix .. " " .. noun,
			Tagline = worldTaglines[(tier - 1) % #worldTaglines + 1],
			Description = worldDescriptions[(tier - 1) % #worldDescriptions + 1]
				.. " World "
				.. string.format("%03d", id)
				.. " ("
				.. worldLayouts[(tier - 1) % #worldLayouts + 1]:lower()
				.. ").",
			Lore = prefix
				.. " "
				.. noun
				.. " is another production stop. Map it, stack upgrades, and let automation carry the rest. World "
				.. string.format("%03d", id)
				.. " leans on "
				.. worldFeatures[(tier - 1) % #worldFeatures + 1][1]
				.. ".",
			Features = {
				worldFeatures[(tier - 1) % #worldFeatures + 1][1] .. " " .. string.format("%03d", id),
				worldFeatures[(tier - 1) % #worldFeatures + 1][2] .. " " .. string.format("%03d", id),
				worldFeatures[(tier - 1) % #worldFeatures + 1][3] .. " " .. string.format("%03d", id),
			},
			Layout = worldLayouts[(tier - 1) % #worldLayouts + 1],
			ThemeIndex = id,
			Trait = worldLayouts[(tier - 1) % #worldLayouts + 1] .. " run " .. string.format("%03d", id),
			Cost = math.floor(math.exp(costExponent)),
			CoreCost = 20 + math.floor(tier * 1.65),
			Multiplier = 12 * (1 + tier * 0.24),
			RequiredRebirths = 20 + math.floor(tier * 0.8),
			Color = color,
			DarkColor = darkColor,
		}
	end
	return zones
end

local function generateGridUpgrades()
	local gridUpgradeCount = 0
	local upgrades = rawget(GameConfig, "GridUpgrades")
	for branchIndex, branch in GameConfig.GridBranches do
		for tier = 1, 420 do
			gridUpgradeCount += 1
			local id = string.format("%s_%02d", branch.Id, tier)
			table.insert(upgrades, {
				Id = id,
				Branch = branch.Id,
				Tier = tier,
				Name = branch.Name .. " " .. string.format("%02d", tier),
				Description = branch.Description,
				EffectKind = branch.EffectKind,
				EffectPerLevel = branch.EffectPerLevel,
				BaseCost = math.max(1, math.floor(branch.BaseCost * 1.32 ^ (tier - 1))),
				CostScale = 1.48,
				MaxLevel = ENDLESS_LEVEL_CAP,
				RequiredRebirths = math.floor((tier - 1) / 4) + math.floor((branchIndex - 1) / 3),
				PreviousId = tier > 1 and string.format("%s_%02d", branch.Id, tier - 1) or nil,
				Color = branch.Color,
			})
		end
	end
	return upgrades
end

local function generateSeasonTiers()
	local tiers = rawget(GameConfig, "Operations").SeasonTiers
	for tier = 1, 300 do
		local reward
		if tier % 10 == 0 then
			reward = { Cores = tier / 10, Stardust = 20 + tier, Signals = 18 + tier, CommandXP = 100 + tier * 8 }
		elseif tier % 5 == 0 then
			reward = {
				Stardust = 15 + tier,
				Signals = 12 + tier,
				Boost = tier % 15 == 0 and "Hyperdrive" or "Overdrive",
				CommandXP = 80 + tier * 6,
			}
		else
			reward =
				{ CashMinutes = 10 + tier * 2, Signals = 4 + math.floor(tier / 2), CommandXP = 35 + tier * 4 }
		end
		table.insert(tiers, {
			Tier = tier,
			RequiredXP = tier * 140 + tier * tier * 22,
			Reward = reward,
		})
	end
	return tiers
end

