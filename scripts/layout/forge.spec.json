		"OutputBig": ".flexc .pn:0 .big",
		"OutputUnit": ".flexc .pn:0 \"per second\"",
		"OutputChips": ".flexc .pn:0 .chip ..",
		"OutputChip": ".flexc .pn:0 .chip",
		"OutputBar": ".flexc .pn:0 .bar",
		"OutputActions": ".flexc .pn:0 .btn.f1 ..",
		"Collect": ".flexc .pn:0 .btn.f1",
		"Overcharge": ".flexc .pn:0 .btn.sec"
	}
