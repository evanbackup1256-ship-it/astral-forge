		"UpgradeName": ".pn.f1 .row:5 b",
		"UpgradeLine": ".pn.f1 .row:5 span",
		"UpgradeBuy": ".pn.f1 .row:5 .btn",
		"Column": ".main .flexr .flexc",
		"Output": ".flexc .pn:0",
