{
	"name": "ForgeLayout",
	"source": "design/03-forge/desktop.html",
	"viewport": [1920, 1080],
	"root": ".screen",
	"origin": ".main .flexr",
	"out": "src/Client/AstralForge/pages/generated/ForgeLayout.ts",
	"nodes": {
		"Body": ".main .flexr",
		"Machines": ".main .flexr .pn.f1",
		"Heading": ".pn.f1 h3",
		"Row": ".pn.f1 .row:0",
		"RowTile": ".pn.f1 .row:0 .it",
		"RowText": ".pn.f1 .row:0 .tt",
		"RowName": ".pn.f1 .row:0 b",
		"RowTail": ".pn.f1 .row:0 b span",
		"RowBar": ".pn.f1 .row:0 .bar.thin",
		"RowValue": ".pn.f1 .row:0 span.v",
		"RowBuy": ".pn.f1 .row:0 .btn.sm",
		"Row2": ".pn.f1 .row:1",
		"Rule": ".pn.f1 .rule",
		"UpgradesHeading": ".pn.f1 h3:1",
		"UpgradeGrid": ".pn.f1 .row:5 ..",
