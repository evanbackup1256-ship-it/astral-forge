{
	"name": "CratesLayout",
	"source": "design/07-crates/desktop.html",
	"viewport": [
		1920,
		1080
	],
	"root": ".screen",
	"origin": ".main .flexr",
	"out": "src/Client/AstralForge/pages/generated/CratesLayout.ts",
	"nodes": {
		"Body": ".main .flexr",
		"Picker": ".flexr .pn.f1",
		"Grid": ".pn.f1 .row ..",
		"Card": ".pn.f1 .row:0",
		"Card2": ".pn.f1 .row:1",
		"CardArt": ".pn.f1 .row:0 svg",
		"CardName": ".pn.f1 .row:0 b",
		"CardRange": ".pn.f1 .row:0 span",
		"CardBtn": ".pn.f1 .row:0 .btn.sm",
