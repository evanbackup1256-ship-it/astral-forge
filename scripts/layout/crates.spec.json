		"OpenOne": ".pn.f1 .flexr .btn.sec.f1",
		"OpenTen": ".pn.f1 .flexr .btn.violet",
		"Auto": ".pn.f1 .flexr .btn.sec:1",
		"Odds": ".flexr .pn:1",
		"OddsRow": ".pn:1 .row:0",
		"OddsRow2": ".pn:1 .row:1",
		"OddsDot": ".pn:1 .row:0 span:0",
		"OddsName": ".pn:1 .row:0 .tt",
		"OddsBar": ".pn:1 .row:0 .bar",
		"OddsValue": ".pn:1 .row:0 .v",
		"CardArtOn": ".pn.f1 .row:2 svg",
		"Tabs": ".hero .tabs",
		"Tab": ".hero .tab:1",
		"TabOn": ".hero .tab.on"
	}
}
